PORT=3001

# ─── Supabase (primary database) ──────────────────────────────────────────────
# Supabase project URL (Settings → General)
SUPABASE_URL=https://omohsdrxgpxaiqldoqhz.supabase.co

# Public anon key (Settings → API → Project API keys → anon public)
SUPABASE_ANON_KEY=

# Service role key — keep secret, used for admin-level DB access
# (Settings → API → Project API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Database connection string (Settings → Database → Connection string → URI)
# Use Transaction mode (port 6543) for pooled connections (Railway/production)
# Use Session mode (port 5432) for direct connections (running migrations locally)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Local dev fallback (used if DATABASE_URL is not set) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jukebox
DB_PASSWORD=jukebox_secret
DB_NAME=jukebox

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Invite links (GTM onboarding) and presigned login links (super admin → venue admin). Same secret for both.
INVITE_TOKEN_SECRET=change_me_invite_secret
# Default UPI VPA for venues created via invite (venue admin can change in settings).
# INVITE_DEFAULT_UPI_VPA=pending@venue

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3
YOUTUBE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# OpenAI (for GTM: find top bars by city, WhatsApp AI replies)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# WasenderAPI (WhatsApp outbound + webhook for inbound)
# Get key from wasenderapi.com. Webhook URL: https://your-api/api/gtm/webhooks/whatsapp
WASENDERAPI_API_KEY=
# Delay in ms between each WhatsApp send when sending to multiple bars (avoids rate limit). Default 3000.
# WASENDER_SEND_DELAY_MS=3000

# CORS — comma-separated list of allowed frontend origins
# Production: set to https://muzobox.com (or add multiple: https://muzobox.com,https://www.muzobox.com)
FRONTEND_URL=http://localhost:5173

# ─── GTM onboarding emails (Resend) ──────────────────────────────────────────
# Required for "Send onboarding email" on the GTM page. Get key from resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# From address (optional). Default: Jukebox <onboarding@resend.dev>. Use your verified domain, e.g. Jukebox <onboarding@muzobox.com>
# GTM_FROM_EMAIL=Jukebox <onboarding@muzobox.com>
# Reply-to for onboarding emails (optional). Replies go here instead of from address.
# GTM_REPLY_TO=support@muzobox.com
# CC on every GTM onboarding email (optional). Default: me@kartikarora.in
# GTM_CC_EMAIL=me@kartikarora.in

# ─── Migrations (optional) ────────────────────────────────────────────────────
# Supabase direct connection (Session mode, port 5432) for running DDL migrations
# Get from: Settings → Database → Connection string → URI (Direct connection)
# Use this instead of the pooler URL when running entrypoint.sh migrations
DATABASE_MIGRATION_URL=postgresql://postgres:[DB-PASSWORD]@db.omohsdrxgpxaiqldoqhz.supabase.co:5432/postgres
