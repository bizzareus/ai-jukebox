PORT=3001

# ─── Supabase (primary database) ──────────────────────────────────────────────
# Supabase project URL (Settings → General)
SUPABASE_URL=https://omohsdrxgpxaiqldoqhz.supabase.co

# Public anon key (Settings → API → Project API keys → anon public)
SUPABASE_ANON_KEY=

# Service role key — keep secret, used for admin-level DB access
# (Settings → API → Project API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Database connection string (Settings → Database → Connection string → URI)
# Use Transaction mode (port 6543) for pooled connections (Railway/production)
# Use Session mode (port 5432) for direct connections (running migrations locally)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Local dev fallback (used if DATABASE_URL is not set) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jukebox
DB_PASSWORD=jukebox_secret
DB_NAME=jukebox

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3
YOUTUBE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# ─── Migrations (optional) ────────────────────────────────────────────────────
# Supabase direct connection (Session mode, port 5432) for running DDL migrations
# Get from: Settings → Database → Connection string → URI (Direct connection)
# Use this instead of the pooler URL when running entrypoint.sh migrations
DATABASE_MIGRATION_URL=postgresql://postgres:[DB-PASSWORD]@db.omohsdrxgpxaiqldoqhz.supabase.co:5432/postgres
